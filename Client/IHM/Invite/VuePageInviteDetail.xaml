<Window x:Class="IHM_Footies.Invite.VuePageInviteDetail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IHM_Footies.Invite"
        mc:Ignorable="d"
        Title="VuePageInviteDetail" Height="450" Width="800"
        Background="#F9F9F9"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="StyleBoutonInvite" TargetType="Button">
            <Setter Property="Background" Value="#8C2F26"/>
            <Setter Property="Foreground" Value="#F9F9F9"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B44B3E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F0F0F0" Margin="5,5,5,69" CornerRadius="10">
            <TextBlock Text="{Binding InviteSelectionne.Identite, UpdateSourceTrigger=PropertyChanged}" 
                       FontSize="18" FontWeight="Bold" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#B44B3E" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Column="0" Margin="5" VerticalAlignment="Bottom">
            <Button Content="Retour" Height="40"
            Style="{StaticResource StyleBoutonInvite}"
            Click="RetourAPage_Click"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="0,23,0,0">

            <TextBlock Text="Les informations de l'invité" 
               FontSize="16" FontWeight="SemiBold" 
               Foreground="#B44B3E" 
               Margin="0,0,0,15" 
               HorizontalAlignment="Center"/>

           
            <Border Background="White" CornerRadius="12" Padding="20" Margin="40,0,40,20"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Nom :" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="{Binding InviteSelectionne.Nom, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1"
                               FontSize="14" Foreground="#333" TextWrapping="Wrap"/>

                    <TextBlock Text="Prénom :" FontWeight="Bold" FontSize="14" Grid.Row="1"/>
                    <TextBlock Text="{Binding InviteSelectionne.Prenom, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"
                               FontSize="14" Foreground="#333" TextWrapping="Wrap"/>

                    <TextBlock Text="Téléphone :" FontWeight="Bold" FontSize="14" Grid.Row="2"/>
                    <TextBlock Text="{Binding InviteSelectionne.Telephone, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" 
                               FontSize="14" Foreground="#333"/>

                    <TextBlock Text="Email :" FontWeight="Bold" FontSize="14" Grid.Row="3"/>
                    <TextBlock Text="{Binding InviteSelectionne.Email, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1"
                               FontSize="14" Foreground="#333" TextWrapping="Wrap"/>

                    <TextBlock Text="Allergies :" FontWeight="Bold" FontSize="14" Grid.Row="4"/>
                    <TextBlock Text="inconnu" Grid.Row="4" Grid.Column="1"
                               FontSize="14" TextWrapping="Wrap" Foreground="#333"/>

                    <TextBlock Text="Goûts :" FontWeight="Bold" FontSize="14" Grid.Row="5"/>
                    <TextBlock Text="inconnu" Grid.Row="5" Grid.Column="1"
                               FontSize="14" TextWrapping="Wrap" Foreground="#333"/>

                    <TextBlock Text="Plat favori :" FontWeight="Bold" FontSize="14" Grid.Row="6"/>
                    <TextBlock Text="inconnu" Grid.Row="6" Grid.Column="1"
                               FontSize="14" TextWrapping="Wrap" Foreground="#333"/>
                </Grid>
            </Border>

            
            <TextBlock Text="Retours et commentaires" 
               FontSize="15" FontWeight="SemiBold" Foreground="#B44B3E"
               Margin="0,0,0,10" HorizontalAlignment="Center"/>

            <Border Background="White" CornerRadius="12" Padding="15"
                    Margin="40,0,40,0" BorderBrush="#E0E0E0" BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Commentaires et impressions" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                    
                    <ComboBox 
                              Height="40" FontSize="14"
                              Background="#FAFAFA" 
                              BorderBrush="#B4B4B4"
                              Padding="8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="20/11/2025" FontWeight="Bold"/>
                                    <TextBlock Text="Nom de l'invitation" Foreground="#555"/>
                                    <TextBlock Text="le retour : commentaire sur l'appriciation du menu" Foreground="#777" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                        <ComboBoxItem Content="Item 1" />
                        <ComboBoxItem Content="Item 2" />

                    </ComboBox>

                </StackPanel>
            </Border>

        </StackPanel>

    </Grid>
</Window>
