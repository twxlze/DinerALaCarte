<Window x:Class="IHM_Footies.Invite.VuePageInviteDetail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IHM_Footies.Invite"
        xmlns:res="clr-namespace:IHM_Footies.Ressources"
        mc:Ignorable="d"
        Title="VuePageInviteDetail" Height="450" Width="800"
        Background="#F9F9F9"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="StyleBoutonInvite" TargetType="Button">
            <Setter Property="Background" Value="#8C2F26"/>
            <Setter Property="Foreground" Value="#F9F9F9"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B44B3E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F0F0F0" Margin="5,5,5,69" CornerRadius="10">
            <TextBlock Text="{Binding InviteSelectionne.Identite, UpdateSourceTrigger=PropertyChanged}" 
                       FontSize="18" FontWeight="Bold" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#B44B3E" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Column="0" Margin="5" VerticalAlignment="Bottom">
            <Button Content="{x:Static res:Strings.BoutonRetour}" Height="40"
            Style="{StaticResource StyleBoutonInvite}"
            Click="RetourAPage_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="10,10,10,10">
            <StackPanel>

                <TextBlock Text="{x:Static res:Strings.InformationInvite}" 
                   FontSize="15" FontWeight="SemiBold" 
                   Foreground="#B44B3E" 
                   Margin="0,0,0,8" 
                   HorizontalAlignment="Center"/>

                <!-- Informations personnelles - Version compressée -->
                <Border Background="White" CornerRadius="10" Padding="12" Margin="20,0,20,10"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Nom -->
                        <TextBlock Text="{x:Static res:Strings.Name}" FontWeight="Bold" FontSize="12" Margin="0,0,8,5"/>
                        <TextBlock Text="{Binding InviteSelectionne.Nom, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1"
                                   FontSize="12" Foreground="#333" TextWrapping="Wrap" Margin="0,0,0,5"/>

                        <!-- Prénom -->
                        <TextBlock Text="{x:Static res:Strings.FirstName}" FontWeight="Bold" FontSize="12" Grid.Row="1" Margin="0,0,8,5"/>
                        <TextBlock Text="{Binding InviteSelectionne.Prenom, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"
                                   FontSize="12" Foreground="#333" TextWrapping="Wrap" Margin="0,0,0,5"/>

                        <!-- Téléphone -->
                        <TextBlock Text="{x:Static res:Strings.Tel}" FontWeight="Bold" FontSize="12" Grid.Row="2" Margin="-3,0,11,5"/>
                        <TextBlock Text="{Binding InviteSelectionne.Telephone, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" 
                                   FontSize="12" Foreground="#333" Margin="0,0,0,5"/>

                        <!-- Email -->
                        <TextBlock Text="{x:Static res:Strings.mail}" FontWeight="Bold" FontSize="12" Grid.Row="3" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding InviteSelectionne.Email, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1"
                                   FontSize="12" Foreground="#333" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- Sections Allergies, Plats détestés et Plats préférés côte à côte -->
                <Grid Margin="20,0,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Allergies -->
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="{x:Static res:Strings.Allergies_invite}" 
                                   FontSize="13" FontWeight="SemiBold" 
                                   Foreground="#B44B3E" 
                                   Margin="0,0,0,5" 
                                   HorizontalAlignment="Center"/>
                        <Border Background="White" CornerRadius="10" Padding="10" 
                                BorderBrush="#E0E0E0" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <ItemsControl ItemsSource="{Binding InviteSelectionne.AllergiesSelectionnes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFF3E0" 
                                                    BorderBrush="#8B0000" 
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="8,4"
                                                    Margin="3">
                                                <TextBlock Text="{Binding Nom}"
                                                           FontSize="11"
                                                           FontWeight="Medium"
                                                           Foreground="#8B0000"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <!-- Plats détestés -->
                    <StackPanel Grid.Column="1" Margin="5,0,5,0">
                        <TextBlock Text="{x:Static res:Strings.Plats_detestes_invite}" 
                                   FontSize="13" FontWeight="SemiBold" 
                                   Foreground="#D57210" 
                                   Margin="0,0,0,5" 
                                   HorizontalAlignment="Center"/>
                        <Border Background="#FFEAD8" CornerRadius="10" Padding="10" 
                                BorderBrush="#D57210" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <ItemsControl ItemsSource="{Binding InviteSelectionne.PlatsDetestes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFF3E0" 
                                                    BorderBrush="#FF9800" 
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="8,4"
                                                    Margin="3">
                                                <TextBlock Text="{Binding Nom}"
                                                           FontSize="11"
                                                           FontWeight="Medium"
                                                           Foreground="#E65100"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <!-- Plats préférés -->
                    <StackPanel Grid.Column="2" Margin="5,0,0,0">
                        <TextBlock Text="{x:Static res:Strings.Plat_prefere_invite}" 
                                   FontSize="13" FontWeight="Bold" 
                                   Foreground="#2D7A2D" 
                                   Margin="0,0,0,5" 
                                   HorizontalAlignment="Center"/>
                        <Border Background="#F1F8F1" CornerRadius="10" Padding="10" 
                                BorderBrush="#4CAF50" BorderThickness="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <ItemsControl ItemsSource="{Binding InviteSelectionne.PlatsPreferes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#E8F5E8" 
                                                    BorderBrush="#4CAF50" 
                                                    BorderThickness="1.5"
                                                    CornerRadius="12"
                                                    Padding="8,4"
                                                    Margin="3">
                                                <TextBlock Text="{Binding Nom}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#2D7A2D"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>
