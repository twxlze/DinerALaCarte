<Window x:Class="IHM_Footies.Invitations.VueNotationPlats"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:IHM_Footies.Ressources"
        mc:Ignorable="d"
        Title="VueNotationPlats" Height="600" Width="1000"
        Background="#F9F9F9"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <BitmapImage x:Key="LogoHostably" UriSource="/Ressources/LogoHostably.png"/>

        <Style x:Key="BoutonMenu" TargetType="Button">
            <Setter Property="Background" Value="#F9F9F9"/>
            <Setter Property="Foreground" Value="#B44B3E"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StyleBoutonMenu" TargetType="Button">
            <Setter Property="Background" Value="#8C2F26"/>
            <Setter Property="Foreground" Value="#F9F9F9"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B44B3E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StyleItemSelection" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="BorderItem" Background="Transparent" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="BorderItem" Property="Background" Value="#B44B3E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderItem" Property="Background" Value="#EFEFEF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>



    <Grid Cursor="Hand">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Source="{StaticResource ResourceKey=LogoHostably}" Margin="-8,-2,117,525"/>

        <Border BorderBrush="#8C2F26" BorderThickness="0,0,2,0" Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="A table !" FontSize="19" FontWeight="Bold" Foreground="#B44B3E" VerticalAlignment="Center" Margin="73,0,23,0" FontFamily="Montserrat"/>

                <Button x:Name="BoutonAccueil" Content="🏠 Accueil" Grid.Row="1" Style="{StaticResource BoutonMenu}"/>
                <Button x:Name="BoutonInvites" Content="👤 Invités" Grid.Row="2" Style="{StaticResource BoutonMenu}"/>
                <Button x:Name="BoutonGroupes" Content="👥 Groupes" Grid.Row="3" Style="{StaticResource BoutonMenu}"/>
                <Button x:Name="BoutonInvitations" Background="#BFBFBF" Content="🎟️ Invitations" Grid.Row="4" Style="{StaticResource BoutonMenu}"/>
                <Button x:Name="BoutonMenus" Content="📋 Menus" Grid.Row="5" Style="{StaticResource BoutonMenu}"/>
                <Button x:Name="BoutonPlats" Content="🍽️ Plats" Grid.Row="6" Style="{StaticResource BoutonMenu}"/>
                <Button x:Name="BoutonStatistique" Content="📊 Statistiques" Grid.Row="7" Style="{StaticResource BoutonMenu}" FontWeight="Bold"/>
                <Button x:Name="BoutonUtilisateur" Content="👤" Grid.Row="10" Grid.Column="0" Style="{StaticResource BoutonMenu}" Margin="0,0,100,0" HorizontalContentAlignment="Center" FontSize="25" />
                <Button x:Name="BoutonReglage" Content="⚙️" Grid.Row="10" Grid.Column="0" Style="{StaticResource BoutonMenu}" HorizontalContentAlignment="Center" Margin="100,0,0,0" FontSize="25"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Notation des plats" FontWeight="Bold" FontSize="24" Foreground="#B44B3E" FontFamily="Poppins" Width="234"/>
            <Button Content="✖" FontSize="16" FontWeight="Bold" BorderThickness="0" Foreground="#B44B3E" Background="Transparent" Margin="724,-5,0,5"/>


            <Grid Grid.Row="1" Margin="10,20,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="1. Sélectionnez un invité" FontWeight="Bold" FontSize="15" Foreground="#B44B3E" Margin="0,0,0,5"/>

                    <Border Grid.Row="1" BorderBrush="#8C2F26" BorderThickness="3" CornerRadius="10" Background="White" Padding="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox ItemsSource="{Binding ListeInvites}" 
                                     SelectedItem="{Binding InviteSelectionne}"
                                     ItemContainerStyle="{StaticResource StyleItemSelection}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Identite}" FontSize="14" FontWeight="Medium" Padding="5"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="2. Sélectionnez un plat" FontWeight="Bold" FontSize="15" Foreground="#B44B3E" Margin="0,0,0,5"/>

                    <Border Grid.Row="1" BorderBrush="#8C2F26" BorderThickness="3" CornerRadius="10" Background="White" Padding="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox ItemsSource="{Binding ListePlats}" 
                                     SelectedItem="{Binding PlatSelectionne}"
                                     ItemContainerStyle="{StaticResource StyleItemSelection}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NomPlat}" FontSize="14" FontWeight="Medium" Padding="5"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="329,10,278,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="127*"/>
                    <ColumnDefinition Width="46*"/>
                </Grid.ColumnDefinitions>


                <TextBlock Text="3. Note attribuée (1-10)" FontWeight="Bold" FontSize="15" Foreground="#B44B3E" Margin="-30,-14,30,42" Grid.ColumnSpan="2"/>

                <Border BorderBrush="#8C2F26" BorderThickness="2" CornerRadius="10" Background="White" Width="100" Height="50" HorizontalAlignment="Left" Margin="0,8,0,-8">
                    <TextBox Text="{Binding NoteSaisie, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="2"
                             FontSize="20" FontWeight="Bold" Foreground="#333"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                             BorderThickness="0" Background="Transparent"/>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="10,0,10,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Commentaire (facultatif)" FontWeight="Bold" FontSize="15" Foreground="#B44B3E" Margin="0,0,0,5"/>

                <Border Grid.Row="1" BorderBrush="#8C2F26" BorderThickness="2" CornerRadius="10" Background="White" Height="100">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding CommentaireSaisi}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" Padding="10"
                             BorderThickness="0" Background="Transparent"
                             FontSize="14" FontFamily="Poppins"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Button Grid.Row="4" Content="Enregistrer la note" 
                    HorizontalAlignment="Right" Margin="0,0,10,20" Width="200" Height="40"
                    Style="{StaticResource StyleBoutonMenu}"/>
        </Grid>
    </Grid>
</Window>