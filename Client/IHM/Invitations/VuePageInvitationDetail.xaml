<Window x:Class="IHM_Footies.Invitations.VuePageInvitationDetail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IHM_Footies.Invitations"
        xmlns:res="clr-namespace:IHM_Footies.Ressources"
        mc:Ignorable="d"
        Title="VuePageInvitationDetail" Height="450" Width="800"
        Background="#F9F9F9"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="StyleBoutonInvite" TargetType="Button">
            <Setter Property="Background" Value="#8C2F26"/>
            <Setter Property="Foreground" Value="#F9F9F9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#40000000" BlurRadius="6" ShadowDepth="2" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B44B3E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StyleTitreSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#8C2F26"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="StyleCarteSection" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#20000000" BlurRadius="8" ShadowDepth="2" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F9F9F9" CornerRadius="12" Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="#60000000" BlurRadius="15" ShadowDepth="4" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panneau latéral gauche -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12,0,0,12">
                <Border.Effect>
                    <DropShadowEffect Color="#10000000" BlurRadius="12" ShadowDepth="0" Opacity="0.15"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Informations de l'invitation -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="15,20,15,0">
                        <!-- Icône décorative -->
                        <Border Width="60" Height="60" 
                                Background="#8C2F26" 
                                CornerRadius="30" 
                                HorizontalAlignment="Center" 
                                Margin="0,0,0,15">
                            <Border.Effect>
                                <DropShadowEffect Color="#40000000" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                            </Border.Effect>
                            <Viewbox Width="35" Height="35">
                                <TextBlock Text="🍽️" FontSize="32"/>
                            </Viewbox>
                        </Border>

                        <!-- Nom de l'invitation -->
                        <TextBlock Text="{Binding Nom}" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center" 
                                   Foreground="#8C2F26" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center" 
                                   Margin="5,0,5,12"/>

                        <!-- Séparateur -->
                        <Border Height="1.5" 
                                Background="#E0E0E0" 
                                CornerRadius="1" 
                                Margin="25,0,25,12"/>

                        <!-- Date -->
                        <Border Background="#FFF3F3" 
                                CornerRadius="8" 
                                Padding="10,6"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Date, StringFormat=dd/MM/yyyy}" 
                                           FontSize="16" 
                                           FontWeight="SemiBold"
                                           Foreground="#555555"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Bouton Retour -->
                    <StackPanel Grid.Row="1" Margin="15,0,15,20">
                        <Button Content="{x:Static res:Strings.BoutonRetour}" 
                                Height="38"
                                Style="{StaticResource StyleBoutonInvite}"
                                Click="RetourAuxInvitations_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Contenu principal centré -->
            <Border Grid.Column="1" Margin="15" Background="Transparent">
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="5" HorizontalAlignment="Center" MaxWidth="550">

                        <!-- Section Invités -->
                        <Border Style="{StaticResource StyleCarteSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="6" Height="6" Fill="#B44B3E" 
                                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Static res:Strings.Invites}" 
                                               Style="{StaticResource StyleTitreSection}"/>
                                </StackPanel>
                                <Border Background="#FAFAFA" 
                                        CornerRadius="6" 
                                        Padding="8"
                                        MinHeight="60"
                                        BorderBrush="#E8E8E8"
                                        BorderThickness="1">
                                    <StackPanel x:Name="PanelInvites" Orientation="Vertical"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Section Groupes d'Invités -->
                        <Border Style="{StaticResource StyleCarteSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="6" Height="6" Fill="#B44B3E" 
                                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Static res:Strings.GroupeInvite}" 
                                               Style="{StaticResource StyleTitreSection}"/>
                                </StackPanel>
                                <Border Background="#FAFAFA" 
                                        CornerRadius="6" 
                                        Padding="8"
                                        MinHeight="60"
                                        BorderBrush="#E8E8E8"
                                        BorderThickness="1">
                                    <StackPanel x:Name="PanelGroupes" Orientation="Vertical"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Section Menus -->
                        <Border Style="{StaticResource StyleCarteSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="6" Height="6" Fill="#B44B3E" 
                                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Static res:Strings.Menus}" 
                                               Style="{StaticResource StyleTitreSection}"/>
                                </StackPanel>
                                <Border Background="#FAFAFA" 
                                        CornerRadius="6" 
                                        Padding="8"
                                        MinHeight="60"
                                        BorderBrush="#E8E8E8"
                                        BorderThickness="1">
                                    <StackPanel x:Name="PanelMenus" Orientation="Vertical"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Section Plats -->
                        <Border Style="{StaticResource StyleCarteSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="6" Height="6" Fill="#B44B3E" 
                                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Static res:Strings.Plats}" 
                                               Style="{StaticResource StyleTitreSection}"/>
                                </StackPanel>
                                <Border Background="#FAFAFA" 
                                        CornerRadius="6" 
                                        Padding="8"
                                        MinHeight="60"
                                        BorderBrush="#E8E8E8"
                                        BorderThickness="1">
                                    <StackPanel x:Name="PanelPlats" Orientation="Vertical"/>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </Border>
</Window>