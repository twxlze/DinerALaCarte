<Window x:Class="IHM_Footies.Invitations.VuePageInvitationDetail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IHM_Footies.Invitations"
        xmlns:res="clr-namespace:IHM_Footies.Ressources"
        mc:Ignorable="d"
        Title="VuePageInvitationDetail" Height="600" Width="900"
        Background="#F9F9F9"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="StyleBoutonInvite" TargetType="Button">
            <Setter Property="Background" Value="#8C2F26"/>
            <Setter Property="Foreground" Value="#F9F9F9"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B44B3E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StyleTitreSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#B44B3E"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>

        <DataTemplate x:Key="ItemTemplateSimple">
            <Border Background="White" CornerRadius="5" Margin="0,2" Padding="10,5" BorderBrush="#E0E0E0" BorderThickness="1">
                <TextBlock Text="{Binding Nom}" FontSize="14" Foreground="#333333"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ItemTemplateInvite">
            <Border Background="White" CornerRadius="5" Margin="0,2" Padding="10,5" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding Prenom}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F0F0F0" Margin="5,5,5,69" CornerRadius="10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Nom}" 
                           FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Foreground="#B44B3E" TextWrapping="Wrap" TextAlignment="Center" Margin="10"/>

                <TextBlock Text="{Binding Date, StringFormat=dd/MM/yyyy}" 
                           FontSize="16" 
                           HorizontalAlignment="Center" 
                           Foreground="#555555" Margin="0,0,0,20"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="0" Margin="5" VerticalAlignment="Bottom">
            <Button Content="{x:Static res:Strings.BoutonRetour}" Height="40"
            Style="{StaticResource StyleBoutonInvite}"
            Click="RetourAuxInvitations_Click"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="20,20,20,20">
            <TextBlock Text="Détails de l'invitation" FontSize="20" FontWeight="SemiBold" 
                       Foreground="#B44B3E" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="500">
                <StackPanel>
                    <TextBlock Text="Menus sélectionnés" Style="{StaticResource StyleTitreSection}"/>
                    <ItemsControl ItemsSource="{Binding Menu}" ItemTemplate="{StaticResource ItemTemplateSimple}"/>

                    <TextBlock Text="Groupes invités" Style="{StaticResource StyleTitreSection}" Margin="0,15,0,5"/>
                    <ItemsControl ItemsSource="{Binding GroupeInvites}" ItemTemplate="{StaticResource ItemTemplateSimple}"/>

                    <TextBlock Text="Invités individuels" Style="{StaticResource StyleTitreSection}" Margin="0,15,0,5"/>
                    <ItemsControl ItemsSource="{Binding Invites}" ItemTemplate="{StaticResource ItemTemplateInvite}"/>

                    <TextBlock Text="Plats à la carte" Style="{StaticResource StyleTitreSection}" Margin="0,15,0,5"/>
                    <ItemsControl ItemsSource="{Binding Plats}" ItemTemplate="{StaticResource ItemTemplateSimple}"/>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>

    </Grid>
</Window>