<Window x:Class="IHM_Footies.Invitations.VuePageAvertissementInvitation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:IHM_Footies.Ressources"
        mc:Ignorable="d"
        Title="Avertissements" Height="450" Width="800"
        Background="#F9F9F9"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">

    <Border>
        <Grid>
            <Grid.Resources>
                <BitmapImage x:Key="LogoHostably" UriSource="/Ressources/LogoHostably.png"/>

                <Style x:Key="StyleBoutonPrincipal" TargetType="Button">
                    <Setter Property="Background" Value="#8C2F26"/>
                    <Setter Property="Foreground" Value="#F9F9F9"/>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="20,0"/>
                    <Setter Property="FontFamily" Value="Poppins"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#B44B3E"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <Style x:Key="StyleBoutonSecondaire" TargetType="Button" BasedOn="{StaticResource StyleBoutonPrincipal}">
                    <Setter Property="Background" Value="#BFBFBF"/>
                    <Setter Property="Foreground" Value="#333333"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#A0A0A0"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <DataTemplate x:Key="ModeleCarteAvertissement">
                    <Border Margin="5,0,5,10" Padding="0" CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F9F9F9"/>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="BandeCouleur" CornerRadius="8,0,0,8" Grid.Column="0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Gray"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Allergie">
                                                <Setter Property="Background" Value="#D32F2F"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="PlatDeteste">
                                                <Setter Property="Background" Value="#FB8C00"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="PlatPrefere">
                                                <Setter Property="Background" Value="#43A047"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="15,12">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding Invite.Identite}" FontWeight="Bold" FontSize="16" FontFamily="Poppins" Foreground="#333333"/>
                                    <TextBlock DockPanel.Dock="Right" FontSize="12" FontFamily="Poppins" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Info"/>
                                                <Setter Property="Foreground" Value="Gray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Allergie">
                                                        <Setter Property="Text" Value="{x:Static res:Strings.AllergieDanger}"/>
                                                        <Setter Property="Foreground" Value="#D32F2F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="PlatDeteste">
                                                        <Setter Property="Text" Value="{x:Static res:Strings.DetesteDanger}"/>
                                                        <Setter Property="Foreground" Value="#FB8C00"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="PlatPrefere">
                                                        <Setter Property="Text" Value="{x:Static res:Strings.PrefereDanger}"/>
                                                        <Setter Property="Foreground" Value="#43A047"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Text="{Binding Message}" FontSize="13" Foreground="#555555" FontFamily="Poppins" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Source="{StaticResource LogoHostably}" Width="40" Margin="20,0,10,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static res:Strings.AnalyseInvit}" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="#B44B3E" 
                               FontFamily="Montserrat"/>
                    <TextBlock Text="{Binding Invitation.Nom}" 
                               FontSize="14" 
                               Foreground="#8C2F26" 
                               FontFamily="Poppins"/>
                </StackPanel>

                <Button x:Name="BoutonFermer" Content="✖" Grid.Column="2" 
                        FontSize="16" FontWeight="Bold" Foreground="#B44B3E" Background="Transparent" 
                        BorderThickness="0" Cursor="Hand" Margin="2,-12,13,13" Click="BoutonFermer_Click"/>

            </Grid>

            <Border Grid.Row="1" Margin="20,15,20,10"
                    BorderBrush="#8C2F26" 
                    BorderThickness="3"
                    CornerRadius="10"
                    Background="#F9F9F9"
                    Padding="5">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ADesAllergies}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{x:Static res:Strings.AllergieDetect}" Foreground="#D32F2F" FontSize="18" FontWeight="Bold" Margin="5,0,0,10" FontFamily="Poppins"/>
                            <ItemsControl ItemsSource="{Binding Allergies}" ItemTemplate="{StaticResource ModeleCarteAvertissement}"/>
                            <Separator Margin="10,20" Background="#E0E0E0"/>
                        </StackPanel>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ADesPlatsDetestes}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{x:Static res:Strings.PlatDest}" Foreground="#FB8C00" FontSize="18" FontWeight="Bold" Margin="5,0,0,10" FontFamily="Poppins"/>
                            <ItemsControl ItemsSource="{Binding PlatsDetestes}" ItemTemplate="{StaticResource ModeleCarteAvertissement}"/>
                            <Separator Margin="10,20" Background="#E0E0E0"/>
                        </StackPanel>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ADesPlatsPreferes}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{x:Static res:Strings.PlatPref}" Foreground="#43A047" FontSize="18" FontWeight="Bold" Margin="5,0,0,10" FontFamily="Poppins"/>
                            <ItemsControl ItemsSource="{Binding PlatsPreferes}" ItemTemplate="{StaticResource ModeleCarteAvertissement}"/>
                        </StackPanel>

                        <Border Margin="5,20,5,10" Padding="30" CornerRadius="8" Background="#F9F9F9">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Avertissements.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{x:Static res:Strings.NoAvertissement}" FontSize="20" FontWeight="Bold" Foreground="#4CAF50" FontFamily="Poppins" HorizontalAlignment="Center" Margin="0,10"/>
                                <TextBlock Text="{x:Static res:Strings.Messageaucunconflit}" FontSize="14" Foreground="#666666" FontFamily="Poppins" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="2" Margin="20,0,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BoutonRetourPlats" Content="{x:Static res:Strings.NoChoix}" Grid.Column="0"
                        Click="BoutonRetourPlats_Click"
                        Height="40">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource StyleBoutonSecondaire}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ADesAvertissementsBloquants}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BoutonAnnuler" Content="{x:Static res:Strings.Annuler}" Margin="0,0,10,0"
                            Click="BoutonAnnuler_Click"
                            Height="40"
                            Style="{StaticResource StyleBoutonSecondaire}"/>

                    <Button x:Name="BoutonConfirmer" Content="{x:Static res:Strings.ValideInvit}"
                            Click="BoutonConfirmer_Click"
                            Height="40"
                            Style="{StaticResource StyleBoutonPrincipal}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>