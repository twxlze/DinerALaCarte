<Window x:Class="IHM_Footies.VueFormulairePlat"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:IHM_Footies"
      xmlns:res="clr-namespace:IHM_Footies.Ressources"
      mc:Ignorable="d" 
      Height="450" Width="800"
      Title="VueFormulairePlat"
      Background="#F9F9F9"
      WindowStyle="None"
      AllowsTransparency="True">

    <Window.Resources>
        <BitmapImage x:Key="LogoHostably" UriSource="/Ressources/LogoHostably.png"/>
        <Style x:Key="BoutonMenu" TargetType="Button">
            <Setter Property="Background" Value="#F9F9F9"/>
            <Setter Property="Foreground" Value="#B44B3E"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StyleBoutonInvite" TargetType="Button">
            <Setter Property="Background" Value="#8C2F26"/>
            <Setter Property="Foreground" Value="#F9F9F9"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        CornerRadius="10"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B44B3E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StyleBoutonEnregistrer" TargetType="Button">
            <Setter Property="Background" Value="#F9F9F9"/>
            <Setter Property="Foreground" Value="#8C2F26"/>
            <Setter Property="BorderBrush" Value="#8C2F26"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="10"
                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B44B3E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StyleTextBox" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#8C2F26"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StyleListBoxSuggestions" TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#8C2F26"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer>
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#B44B3E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="2*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Bouton fermer -->
        <Button x:Name="CloseButton"
         Content="✖"
         FontSize="16"
         FontWeight="Bold"
         Foreground="#B44B3E"
         Background="Transparent"
         BorderThickness="0"
         Cursor="Hand"
         HorizontalAlignment="Right"
         VerticalAlignment="Top"
         Margin="0,5,8,0"
         Click="ButonFermerFenetre_Click"
         Grid.Column="1"/>

        <!-- Menu à gauche -->
        <Border BorderBrush="#8C2F26" BorderThickness="0,0,2,0" Grid.Column="0" Grid.RowSpan="9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="À table !" FontSize="20" FontWeight="Bold" Foreground="#B44B3E" VerticalAlignment="Top" Height="27" Margin="82,34,33,0" FontFamily="Montserrat"/>
                <Button x:Name="BoutonAccueil" Content="{x:Static res:Strings.Accueil}" Grid.Row="1" Grid.Column="0" Style="{StaticResource BoutonMenu}"  Click="BoutonAllerAccueil_Click"/>
                <Button x:Name="BoutonInvites" Content="{x:Static res:Strings.Invites}" Grid.Row="2" Grid.Column="0" Style="{StaticResource BoutonMenu}" Click="BoutonAllerInvite_Click" />
                <Button x:Name="BoutonGroupes" Content="{x:Static res:Strings.GroupeInvite}" Grid.Row="3" Grid.Column="0" Style="{StaticResource BoutonMenu}" Click="BoutonAllerGroupeInvite_Click"/>
                <Button x:Name="BoutonInvitations" Content="{x:Static res:Strings.Invitations}" Grid.Row="4" Grid.Column="0" Style="{StaticResource BoutonMenu}" Click="BoutonAllerInvitation_Click"/>
                <Button x:Name="BoutonMenus" Content="{x:Static res:Strings.Menus}" Grid.Row="5" Grid.Column="0" Style="{StaticResource BoutonMenu}" Cursor="Hand" Click="BoutonAllerMenu_Click" />
                <Button x:Name="BoutonPlats" Content="{x:Static res:Strings.Plats}" Grid.Row="6" Grid.Column="0" Style="{StaticResource BoutonMenu}" Click="BoutonAllerPlat_Click" Background="#BFBFBF" FontWeight="Bold"/>
                <Button x:Name="BoutonUtilisateur" Content="👤" Grid.Row="8" Grid.Column="0" Style="{StaticResource BoutonMenu}" Margin="0,0,100,0" HorizontalContentAlignment="Center" FontSize="25"/>
                <Button x:Name="BoutonReglage" Content="⚙️" Grid.Row="8" Grid.Column="0" Style="{StaticResource BoutonMenu}" HorizontalContentAlignment="Center" Margin="100,0,0,0" FontSize="25" Click="BoutonAllerReglages_Click"/>

            </Grid>
        </Border>
        <Image Source="{StaticResource ResourceKey=LogoHostably}" Margin="14,10,122,17"/>

        <!-- Partie droite -->

        <!-- Titre principal -->
        <TextBlock Grid.Column="1" 
                   HorizontalAlignment="Center" 
                   TextWrapping="Wrap" 
                   Text="{x:Static res:Strings.GestionPlats}" 
                   VerticalAlignment="Top" 
                   FontWeight="Bold" 
                   FontSize="20" 
                   Foreground="#B44B3E" 
                   Margin="0,20,0,0"/>

        <!-- Sous-titre -->
        <TextBlock Grid.Column="1" 
                   Grid.Row="1"
                   HorizontalAlignment="Center" 
                   TextWrapping="Wrap" 
                   Text="{x:Static res:Strings.Information}" 
                   VerticalAlignment="Top" 
                   FontWeight="SemiBold" 
                   FontSize="16" 
                   Foreground="#B44B3E" 
                   Margin="0,5,0,0"/>

        <!-- Container formulaire principal -->
        <Border Grid.Column="1" Grid.RowSpan="8"
                BorderBrush="#8C2F26"
                BorderThickness="3"
                CornerRadius="10"
                Background="White"
                Padding="20"
                Margin="10,52,10,41">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <!-- Partie gauche : Formulaire principal -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ligne 1: Nom -->
                        <Label Grid.Row="0" Grid.Column="0"
                               Content="{x:Static res:Strings.Nom}" 
                               FontSize="14" 
                               Foreground="#B44B3E" 
                               VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Height="32"
                                 Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource StyleTextBox}"/>

                        <!-- Ligne 2: Catégorie -->
                        <Label Grid.Row="1" Grid.Column="0"
                               Content="{x:Static res:Strings.Categorie}" 
                               FontSize="14" 
                               Foreground="#B44B3E" 
                               VerticalAlignment="Center"
                               Margin="0,10,0,0"/>
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  Height="32"
                                  Margin="0,10,0,0"
                                  SelectedIndex="{Binding CategorieIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  BorderBrush="#8C2F26"
                                  BorderThickness="1.5">
                            <ComboBoxItem Content="{x:Static res:Strings.Aperitif}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.Entree}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.Plat}"/>
                            <ComboBoxItem Content="{x:Static res:Strings.Dessert}"/>
                        </ComboBox>

                        <!-- Ligne 3: Description -->
                        <Label Grid.Row="2" Grid.Column="0"
                               Content="{x:Static res:Strings.Description}" 
                               FontSize="14" 
                               Foreground="#B44B3E" 
                               VerticalAlignment="Top"
                               Margin="0,10,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Height="70"
                                 Margin="0,10,0,0"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource StyleTextBox}"
                                 VerticalContentAlignment="Top"
                                 Padding="6"/>

                        <!-- Ligne 4: Ingrédients -->
                        <Label Grid.Row="3" Grid.Column="0"
                               Content="Ingrédients" 
                               FontSize="14" 
                               Foreground="#B44B3E" 
                               VerticalAlignment="Top"
                               Margin="0,10,0,0"/>
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Height="70"
                                 Margin="0,10,0,0"
                                 Text="{Binding Ingredients, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource StyleTextBox}"
                                 VerticalContentAlignment="Top"
                                 Padding="6"/>
                    </Grid>
                </ScrollViewer>

                <!-- Partie droite : Sélection des allergènes -->
                <Border Grid.Column="1"
                        BorderBrush="#8C2F26" 
                        BorderThickness="3"
                        CornerRadius="10"
                        Padding="10"
                        Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Titre de la section allergènes -->
                        <TextBlock Grid.Row="0"
                                   Text="Allergènes" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"
                                   Foreground="#B44B3E"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <!-- Liste des allergènes sélectionnables -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AllergenesListe}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Nom}"
                                                  IsChecked="{Binding EstSelectionne}"
                                                  Margin="5,3"
                                                  FontSize="12"
                                                  Foreground="#333333"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Bouton enregistrer -->
        <Button Grid.Column="1"
                Grid.Row="7"
                Content="{x:Static res:Strings.Enregistrer}" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Top"
                Height="42" 
                Width="240" 
                Style="{StaticResource StyleBoutonEnregistrer}" 
                Click="Enregistrer_Click" Margin="0,57,0,0" Grid.RowSpan="2" />
    </Grid>
</Window>