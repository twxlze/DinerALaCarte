<UserControl x:Class="IHM_Footies.VueInviteDansGroupeInvite"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IHM_Footies"
             Height="500" Width="900">

    <UserControl.Resources>
        <!-- Style pour le bouton Ajouter/Supprimer -->
        <Style x:Key="StyleBoutonInvite" TargetType="Button">
            <Setter Property="Background" Value="#8C2F26"/>
            <Setter Property="Foreground" Value="#F9F9F9"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B44B3E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Nom du groupe -->
            <ColumnDefinition Width="*"/>
            <!-- Liste des invités du groupe -->
            <ColumnDefinition Width="*"/>
            <!-- Liste de tous les invités -->
        </Grid.ColumnDefinitions>

        <!-- Nom du groupe -->
        <Border Grid.Column="0" Background="#F0F0F0" Margin="5" CornerRadius="10">
            <TextBlock Text="{Binding NomGroupe}" 
                       FontSize="18" FontWeight="Bold" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#B44B3E"/>
        </Border>

        <!-- Liste des invités dans le groupe -->
        <StackPanel Grid.Column="1" Margin="5">
            <TextBlock Text="Invités du groupe" FontSize="16" FontWeight="SemiBold" 
                       Foreground="#B44B3E" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            <ListBox ItemsSource="{Binding ListeInvitesDansGroupe}" 
                     SelectedItem="{Binding InviteSelectionneDansGroupe}" 
                     DisplayMemberPath="Identite"
                     Height="360" BorderBrush="Gray" BorderThickness="1"/>

            <!-- Bouton Supprimer -->
            <Button Content="Supprimer" 
                    Width="180" Height="40" Margin="0,10,0,0"
                    Style="{StaticResource StyleBoutonInvite}"
                    Command="{Binding SupprimerInviteCommande}"/>
        </StackPanel>

        <!-- Liste de tous les invités et bouton Ajouter -->
        <StackPanel Grid.Column="2" Margin="5">
            <TextBlock Text="Tous les invités" FontSize="16" FontWeight="SemiBold" 
                       Foreground="#B44B3E" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            <ListBox ItemsSource="{Binding ListeTousLesInvites}" 
                     SelectedItem="{Binding InviteSelectionne}" 
                     DisplayMemberPath="Identite"
                     Height="360" BorderBrush="Gray" BorderThickness="1"/>

            <!-- Bouton Ajouter -->
            <Button Content="Ajouter" 
                    Width="180" Height="40" Margin="0,10,0,0"
                    Style="{StaticResource StyleBoutonInvite}"
                    Command="{Binding AjouterInviteCommande}"/>
        </StackPanel>
    </Grid>
</UserControl>
