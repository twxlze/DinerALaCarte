<Window x:Class="IHM_Footies.GroupeInvite.VuePageDetailInviteDansGroupe"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IHM_Footies.GroupeInvite"
        mc:Ignorable="d"
        Title="VuePageDetailInviteDansGroupe" Height="450" Width="800"
        Background="#F9F9F9"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="StyleBoutonInvite" TargetType="Button">
            <Setter Property="Background" Value="#8C2F26"/>
            <Setter Property="Foreground" Value="#F9F9F9"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B44B3E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <Border Grid.Column="0" Background="#F0F0F0" Margin="5,5,5,69" CornerRadius="10">
            <TextBlock Text="{Binding NomGroupeSelectionne}" 
                       FontSize="18" FontWeight="Bold" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#B44B3E" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Column="0" Margin="5" VerticalAlignment="Bottom">
            <Button Content="Retour" Height="40"
            Style="{StaticResource StyleBoutonInvite}"
            Click="RetourAuGroupeInvite_Click"/>
        </StackPanel>


        <StackPanel Grid.Column="1" Margin="0,40,0,0"
>
            <TextBlock Text="Invités du groupe" FontSize="16" FontWeight="SemiBold" 
                       Foreground="#B44B3E" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="306" BorderBrush="Gray" BorderThickness="1">
                <StackPanel Orientation="Vertical" x:Name="PanelInvitesDansGroupe"/>
            </ScrollViewer>
        </StackPanel>

    </Grid>
</Window>
