<Window x:Class="IHM_Footies.Connexion.VueCreationCompte"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IHM_Footies.Connexion"
        mc:Ignorable="d"
        Title="Créer un compte - Hostably" Height="450" Width="800"
        Background="#F9F9F9"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BitmapImage x:Key="LogoHostably" UriSource="/Ressources/LogoHostably.png"/>

        <Style x:Key="StyleBoutonAction" TargetType="Button">
            <Setter Property="Background" Value="#8C2F26"/>
            <Setter Property="Foreground" Value="#F9F9F9"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B44B3E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StyleChampSaisie" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#8C2F26"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="5,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StyleChampMotDePasse" TargetType="PasswordBox">
            <Setter Property="BorderBrush" Value="#8C2F26"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="5,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StyleLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Poppins"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#B44B3E"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Button x:Name="CloseButton" Content="✖" FontSize="16" FontWeight="Bold" Foreground="#B44B3E" 
                Background="Transparent" BorderThickness="0" Cursor="Hand" 
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" 
                Click="BoutonFermerFenetre_Click"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Image Source="{StaticResource ResourceKey=LogoHostably}" Width="50" Height="50" Margin="0,0,15,0"/>
                <TextBlock Text="CRÉER UN COMPTE" FontSize="24" FontWeight="Bold" Foreground="#B44B3E" 
                           VerticalAlignment="Center" FontFamily="Montserrat"/>
            </StackPanel>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="Nom" Style="{StaticResource StyleLabel}"/>
                    <TextBox x:Name="ChampNom" Text="{Binding Nom}" Style="{StaticResource StyleChampSaisie}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="Prénom" Style="{StaticResource StyleLabel}"/>
                    <TextBox x:Name="ChampPrenom" Text="{Binding Prenom}" Style="{StaticResource StyleChampSaisie}"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="2">
                    <TextBlock Text="Email" Style="{StaticResource StyleLabel}"/>
                    <TextBox x:Name="ChampEmail" Text="{Binding Email}" Style="{StaticResource StyleChampSaisie}"/>
                </StackPanel>


                <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Pseudo" Style="{StaticResource StyleLabel}"/>
                        <TextBlock Text="*" Foreground="Red" FontWeight="Bold" Margin="4,0,0,0"/>
                    </StackPanel>
                    <TextBox x:Name="ChampPseudo" Text="{Binding Pseudo}" Style="{StaticResource StyleChampSaisie}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="Numéro de téléphone" Style="{StaticResource StyleLabel}"/>
                    <TextBox x:Name="ChampTelephone" Text="{Binding Telephone}" Style="{StaticResource StyleChampSaisie}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mot de passe" Style="{StaticResource StyleLabel}"/>
                        <TextBlock Text="*" Foreground="Red" FontWeight="Bold" Margin="4,0,0,0"/>
                    </StackPanel>
                    <PasswordBox x:Name="ChampMotDePasse" Style="{StaticResource StyleChampMotDePasse}"/>
                </StackPanel>
            </Grid>

            <Button x:Name="BoutonEnregistrer" Content="S'enregistrer" Style="{StaticResource StyleBoutonAction}" 
                    Width="200" Height="40" Click="BoutonEnregistrer_Click" Margin="0,0,0,10"/>

            <Button Content="Retour à la connexion" Foreground="#666" Background="Transparent" 
                    BorderThickness="0" Cursor="Hand" FontSize="12" 
                    HorizontalAlignment="Center" Click="BoutonRetourConnexion_Click"/>

        </StackPanel>
    </Grid>
</Window>