<UserControl x:Class="IHM_Footies.TableauDeBord.VueTableauDeBord"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IHM_Footies.TableauDeBord"
             xmlns:res="clr-namespace:IHM_Footies.Ressources"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <Style x:Key="StyleParticipation" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#444"/>
        </Style>
    </UserControl.Resources>


    <Border 
        Margin="10"
        Background="#FAFAFA"
        CornerRadius="12"
        BorderBrush="#D0D0D0"
        BorderThickness="1"
        Padding="10">

        <Expander>
            <Expander.Header>
                <Border Background="#E8E8E8" CornerRadius="8" Padding="8" Margin="0,0,0,5">
                    <StackPanel Orientation="Horizontal"  VerticalAlignment="Center">
                        <TextBlock Text="{Binding IdentiteInvite}" 
                                   FontWeight="Bold" FontSize="14" Foreground="#8C2F26"/>

                        <TextBlock Text="( " Style="{StaticResource StyleParticipation}"/>
                        <TextBlock Text="{Binding NombreParticipation}" Style="{StaticResource StyleParticipation}" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Static res:Strings.NbFoisInvite}" Style="{StaticResource StyleParticipation}"/>
                        <TextBlock Text=" )" Style="{StaticResource StyleParticipation}"/>
                    </StackPanel>
                </Border>
            </Expander.Header>


            <StackPanel>
                <ItemsControl ItemsSource="{Binding InvitationsParticipe}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border 
                                Margin="0,4"
                                Padding="8"
                                Background="#FFFFFF"
                                CornerRadius="6"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1">

                                <StackPanel Orientation="Vertical" >
                                    <StackPanel Orientation="Horizontal" >
                                        <TextBlock Text="{x:Static res:Strings.Invitations}" 
                                               FontWeight="SemiBold" />
                                        <TextBlock Text=" : " 
                                               FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding FormatInvitation}" />
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" >
                                        <TextBlock Text="{x:Static res:Strings.Remarque}" 
                                               FontWeight="SemiBold" />
                                        <TextBlock Text=" : " 
                                               FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Remarque}"/>
                                    </StackPanel>
                                </StackPanel>

                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>

        </Expander>
    </Border>

</UserControl>