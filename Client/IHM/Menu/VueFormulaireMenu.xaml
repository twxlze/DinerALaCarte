            </Grid>
        </Border>
        <Image Source="{StaticResource ResourceKey=LogoHostably}" Margin="14,10,122,17"/>

        <!-- Partie droite -->

        <!-- Titre -->
        <TextBlock Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap" 
                   Text="{x:Static res:Strings.GestionMenu}" VerticalAlignment="Top" 
                   FontWeight="Bold" FontSize="20" Foreground="#B44B3E" Margin="0,20,0,0"/>

        <!-- Sous-titre -->
        <TextBlock Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap" 
                   Text="{x:Static res:Strings.Information}" VerticalAlignment="Top" 
                   FontWeight="SemiBold" FontSize="16" Foreground="#B44B3E" 
                   Margin="0,65,0,0" Grid.RowSpan="2"/>

        <!-- Nom du menu -->
        <Label Grid.Column="1" Margin="232,4,160,4" Grid.Row="1" FontSize="16" 
               Foreground="#B44B3E" Content="{x:Static res:Strings.NomDuMenu}"/>
        <TextBox Grid.Column="1" Margin="106,34,106,20" Grid.Row="1" Height="25" 
                 Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}" Grid.RowSpan="2"/>

        <!-- Titre des catégories -->
        <Label Grid.Column="1" Margin="200,18,193,24" Grid.Row="2" FontSize="16" 
               Foreground="#B44B3E" Grid.RowSpan="2" Content="{x:Static res:Strings.CategoriesDansMenu}"/>

        <!-- Labels des catégories -->
        <Label Grid.Column="1" Margin="51,10,471,31" Grid.Row="3" FontSize="16" 
               Foreground="#B44B3E" Grid.RowSpan="2" Content="{x:Static res:Strings.Aperitif}"/>
        <Label Grid.Column="1" Margin="194,7,348,37" Grid.Row="3" FontSize="16" 
               Foreground="#B44B3E" Grid.RowSpan="2" Content="{x:Static res:Strings.Entree}"/>
        <Label Grid.Column="1" Margin="349,7,193,37" Grid.Row="3" FontSize="16" 
               Foreground="#B44B3E" Grid.RowSpan="2" Content="{x:Static res:Strings.Plat}"/>
        <Label Grid.Column="1" Margin="477,7,59,37" Grid.Row="3" FontSize="16" 
               Foreground="#B44B3E" Grid.RowSpan="2" Content="{x:Static res:Strings.Dessert}"/>

        <!-- Container Apéritif -->
        <Border BorderBrush="#8C2F26" 
                Grid.Column="1" Grid.RowSpan="5" 
                Margin="21,39,459,61"
                BorderThickness="3"
                CornerRadius="10"
                Padding="5" Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding PlatsAperitif}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Nom}"
                                      IsChecked="{Binding EstSelectionne}"
                                      Margin="5"
                                      FontSize="12"
                                      Foreground="#333333"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Container Entrée -->
        <Border BorderBrush="#8C2F26" 
                Grid.Column="1" Grid.RowSpan="5" 
                Margin="162,39,316,61"
                BorderThickness="3"
                CornerRadius="10"
                Padding="5" Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding PlatsEntree}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Nom}"
                                      IsChecked="{Binding EstSelectionne}"
                                      Margin="5"
                                      FontSize="12"
                                      Foreground="#333333"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Container Plat -->
        <Border BorderBrush="#8C2F26" 
                Grid.Column="1" Grid.RowSpan="5" 
                Margin="309,39,170,61"
                BorderThickness="3"
                CornerRadius="10"
                Padding="5" Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding PlatsPlat}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Nom}"
                                      IsChecked="{Binding EstSelectionne}"
                                      Margin="5"
                                      FontSize="12"
                                      Foreground="#333333"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Container Dessert -->
        <Border BorderBrush="#8C2F26" 
                Grid.Column="1" Grid.RowSpan="5" 
                Margin="448,39,30,61"
                BorderThickness="3"
                CornerRadius="10"
                Padding="5" Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding PlatsDessert}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Nom}"
                                      IsChecked="{Binding EstSelectionne}"
                                      Margin="5"
                                      FontSize="12"
                                      Foreground="#333333"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Bouton Enregistrer -->
        <Button Grid.RowSpan="2" Grid.Column="1" Content="{x:Static res:Strings.Enregistrer}" 
                HorizontalAlignment="Center" Margin="0,58,0,0" Grid.Row="7" 
                VerticalAlignment="Top" Height="40" Width="240" 
                Style="{StaticResource StyleBoutonEnregistrer}" 
                Click="Enregistrer_Click"/>
    </Grid>
</Window>